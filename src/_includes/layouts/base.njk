<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="author" content="Oliver Child">
		<meta name="description" content ="Oliver Child's homepage and portfolio">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link href="/css/main.css?v={{ buildVersion }}" rel="stylesheet" type="text/css">
		{% if extra_css %}
		<link href="/css/{{ extra_css }}?v={{ buildVersion }}" rel="stylesheet" type="text/css">
		{% endif %}
		<script src="/scripts/gallery.js?v={{ buildVersion }}" defer></script>
		<title>
			{{ title or "Oliver Child" }}
		</title>
	</head>

	<body>
		<nav id="nav">
			{% if page.url != "/" %}<a href="/" class="nav-name">OLIVER CHILD</a>{% endif %}
			<span class="nav-links">
				<a href="/" {% if page.url == "/" %}class="active"{% endif %}>Research</a>
				<a href="/projects/" {% if page.url == "/projects/" %}class="active"{% endif %}>Projects</a>
			</span>
		</nav>
		<div id="title">
            {% if heading %}
			<h1>
			{{ heading }}
			</h1>
            {% endif %}

            {{ content | safe }}

		</div>
		<footer>
			<p align="center">Oliver Child © {% year %}</p>
		</footer>
	</body>
</html>
